{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug*", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/landscaping-:slug", "destination": "/landscaping-:slug.html" },
    { "source": "/landscape-design", "destination": "/landscape-design.html" },
    { "source": "/hardscaping", "destination": "/hardscaping.html" },
    { "source": "/tree-care", "destination": "/tree-care.html" },
    { "source": "/irrigation-drainage", "destination": "/irrigation-drainage.html" }
  ]
}
